# Voyage AI Configuration
VOYAGE_API_KEY=pa-your-voyage-api-key-here
VOYAGE_MODEL=voyage-3

# Qdrant Vector Store Configuration
# For local embedded storage without cloud/docker, set QDRANT_URL=local
# For Qdrant Cloud, set QDRANT_URL=https://your-cluster-id.aws.cloud.qdrant.io:6333
QDRANT_URL=local
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=ashen_era_corpus

# LLM / Reasoning Model (OpenRouter / DeepSeek / Gemini)
OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-r1:free
